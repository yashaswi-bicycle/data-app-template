{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bicycle.ai/schemas/dataapp-spec.v2.json",
  "title": "DataAppSpec v2",
  "description": "What the Ask, Show, Ship interview collects, for any semantic model in any tenant. A generic core (measures, dimensions, optional entity, time) plus an optional analysis family that adds derived metrics and its own recipes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "model", "title", "persona", "template", "time", "measures", "dimensions", "questions"],
  "properties": {
    "version": { "const": 2 },
    "appId": { "type": "string", "pattern": "^app_[a-f0-9]{20}$", "description": "Set once the app exists." },
    "model": { "type": "string", "minLength": 4, "maxLength": 32 },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "decision": { "type": "string", "maxLength": 300 },
    "persona": { "enum": ["biz", "pm", "analyst", "exec"] },
    "template": { "enum": ["scorecard", "report", "explorer", "brief"] },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "column": { "$ref": "#/$defs/field", "default": "timestamp" },
        "from": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "to": { "type": "string", "pattern": "^(tomorrow|\\d{4}-\\d{2}-\\d{2})$" },
        "grain": { "enum": ["day", "week", "month"], "default": "day" }
      }
    },
    "entity": {
      "type": "object",
      "description": "Present when the app is about one thing at a time (an experiment, a store, a route). Absent for a whole-model view.",
      "additionalProperties": false,
      "required": ["field", "label"],
      "properties": {
        "field": { "$ref": "#/$defs/field" },
        "label": { "type": "string", "maxLength": 40 },
        "type": { "enum": ["number", "string"], "default": "number" },
        "list": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rank"],
          "properties": {
            "label": { "$ref": "#/$defs/field" },
            "description": { "$ref": "#/$defs/field" },
            "status": { "$ref": "#/$defs/field" },
            "group": { "$ref": "#/$defs/field" },
            "end": { "$ref": "#/$defs/field" },
            "rank": { "$ref": "#/$defs/field" }
          }
        }
      }
    },
    "measures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "column", "label"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
          "column": { "$ref": "#/$defs/field", "description": "A metric column of the model, as query_describe_model lists it." },
          "label": { "type": "string", "maxLength": 60 },
          "format": { "enum": ["number", "currency", "percent", "rate"], "default": "number", "description": "rate = already a percentage value (15.7 means 15.7%)" },
          "good": { "enum": ["up", "down"], "default": "up" },
          "role": { "enum": ["primary", "secondary"], "default": "secondary" },
          "definition": { "type": "string", "maxLength": 400, "description": "The semantic layer's plain-language definition of this measure, for the \"How is this computed?\" provenance popover." },
          "expression": { "type": "string", "maxLength": 400, "description": "The semantic layer's expression for this measure (e.g. a metric formula), for the provenance popover." }
        }
      }
    },
    "dimensions": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "label"],
        "properties": {
          "field": { "$ref": "#/$defs/field" },
          "label": { "type": "string", "maxLength": 40 }
        }
      }
    },
    "family": {
      "type": "object",
      "description": "An analysis family adds derived metrics, datasets and recipes. Omit for the generic core.",
      "required": ["kind"],
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["kind", "arms", "roles"],
          "properties": {
            "kind": { "const": "ab_test" },
            "arms": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field", "control"],
              "properties": {
                "field": { "$ref": "#/$defs/field" },
                "control": { "type": "string", "minLength": 1, "maxLength": 40 },
                "exclude": { "type": "array", "items": { "type": "string" }, "default": ["CONTROL"] }
              }
            },
            "roles": {
              "type": "object",
              "description": "Measure ids that play each role in the incremental maths.",
              "additionalProperties": false,
              "required": ["bookers", "orders", "value", "participants"],
              "properties": {
                "bookers": { "$ref": "#/$defs/measureId" },
                "orders": { "$ref": "#/$defs/measureId" },
                "value": { "$ref": "#/$defs/measureId" },
                "participants": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["arm", "control", "total"],
                  "properties": {
                    "arm": { "$ref": "#/$defs/measureId" },
                    "control": { "$ref": "#/$defs/measureId" },
                    "total": { "$ref": "#/$defs/measureId" }
                  }
                }
              }
            },
            "context": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "description": { "$ref": "#/$defs/field" },
                "tag": { "$ref": "#/$defs/field" },
                "status": { "$ref": "#/$defs/field" },
                "start": { "$ref": "#/$defs/field" },
                "end": { "$ref": "#/$defs/field" },
                "as_of": { "$ref": "#/$defs/field" },
                "group": { "$ref": "#/$defs/field" }
              }
            }
          }
        }
      ]
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["say", "recipe"],
        "properties": {
          "say": { "type": "string", "maxLength": 200 },
          "recipe": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
          "bind": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "controls": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": { "enum": ["entity", "measure", "depth", "dimensions", "variant", "heatmap_axes", "grain", "filter", "time"] },
          "dim": { "$ref": "#/$defs/field", "description": "filter only: the declared dimension this control narrows." },
          "multi": { "type": "boolean", "description": "filter only: the viewer may pick several values." },
          "slots": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "filter only: how many values the viewer may narrow to at once. One query parameter each, so it is capped; defaults to min(options, 5)."
          },
          "presets": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["7d", "30d", "90d", "quarter", "ytd"] },
            "description": "time only: the ranges offered."
          },
          "options": { "type": "array", "items": {} },
          "default": {}
        },
        "allOf": [
          { "if": { "properties": { "kind": { "const": "filter" } }, "required": ["kind"] }, "then": { "required": ["dim"] } },
          { "if": { "not": { "properties": { "kind": { "const": "filter" } } } }, "then": { "properties": { "dim": false, "multi": false, "slots": false } } },
          { "if": { "not": { "properties": { "kind": { "const": "time" } } } }, "then": { "properties": { "presets": false } } }
        ]
      }
    },
    "words": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 60 }, "description": "Display names keyed by measure id or derived metric id." },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "confidence_bar": { "enum": ["80%", "90%", "95%", "99%"], "default": "90%" },
        "min_bookers": { "type": "integer", "minimum": 0, "default": 0 },
        "trim_quartile": { "type": "boolean", "default": true },
        "compare_periods": { "type": "integer", "minimum": 1, "maximum": 90, "default": 7, "description": "Core verdict/kpis: last N periods vs the N before." },
        "targets": { "type": "object", "additionalProperties": { "type": "number" }, "description": "Optional target per measure id for the core verdict." },
        "targets_blob": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$", "description": "A declared blob holding {measure_id: target} (optionally per segment: {measure_id: {\"<dim>=<value>\": target}}); overrides rules.targets when present." }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accent": { "enum": ["blue", "teal", "purple", "amber", "coral"], "default": "blue" },
        "follow": { "enum": ["system", "light", "dark"], "default": "system" }
      }
    },
    "store": {
      "type": "object",
      "description": "Persistence the app may use at runtime, brokered by the host and scoped to this app and tenant. Cache: small, shared, expiring values (a saved target, an annotation, a memoised result). Blobs: large read-only objects the builder uploads once (lookup tables, targets per segment, model weights).",
      "additionalProperties": false,
      "properties": {
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ttl_seconds": { "type": "integer", "minimum": 60, "maximum": 2592000, "default": 86400 },
            "max_value_bytes": { "type": "integer", "minimum": 1024, "maximum": 262144, "default": 65536 },
            "writable_by": { "enum": ["viewer", "builder"], "default": "viewer", "description": "viewer: anyone who can open the app may write (shared state). builder: only apps:write." }
          }
        },
        "blobs": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "purpose"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
              "purpose": { "type": "string", "maxLength": 200 },
              "kind": { "enum": ["json", "csv", "binary"], "default": "json" },
              "max_bytes": { "type": "integer", "minimum": 1024, "maximum": 104857600, "default": 10485760 }
            }
          }
        }
      }
    },
    "panels": {
      "type": "array",
      "description": "Resolved by the composer. Not authored by hand.",
      "items": {
        "type": "object",
        "required": ["recipe"],
        "properties": { "recipe": { "type": "string" }, "bind": { "type": "object" }, "say": { "type": "string" }, "width": { "enum": ["full", "half", "third"] }, "explain": { "type": "string", "description": "The recipe's `explain` sentence (T3.6), threaded through by the composer for the \"How is this computed?\" provenance popover's Method section." } }
      }
    },
    "telemetry": {
      "type": "object",
      "description": "Whether the host page may record what happens in this app. The frame cannot reach an analytics service itself (opaque origin, connect-src 'none'), so it reports over postMessage and the host forwards. Undeclared, the host drops those messages. `values` decides whether observed numbers travel too — structure is about the app, values are the tenant's own data in a third party's store, so it defaults to false.",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "values": { "type": "boolean", "default": false }
      }
    },
    "analyses": {
      "type": "array",
      "maxItems": 16,
      "description": "Ad hoc Detect & Explain questions the app may ask as its viewer, carried verbatim into the manifest's `analyses`. A `changes` panel runs one through the host (`studio:sandbox:analysis`). `config` is the service's closed-world cfgDetect / cfgExplain object and is validated by the service on upload; the kit checks only its outline.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "config"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
          "kind": { "enum": ["detect", "explain"] },
          "title": { "type": "string", "maxLength": 120 },
          "config": {
            "type": "object",
            "required": ["request", "window"],
            "properties": { "request": { "type": "object", "required": ["kpi_name", "dimensions"] }, "window": { "type": "object" }, "baseline_window": { "type": "object" }, "filters": { "type": "array", "maxItems": 8 } }
          },
          "bind": { "type": "object", "additionalProperties": false, "properties": { "window": { "type": "boolean", "default": true }, "filters": { "type": "boolean", "default": true } } },
          "calendar": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "timezone": { "type": "string", "maxLength": 64 },
              "week_start": { "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"] },
              "grain": { "enum": ["day", "hour"] }
            }
          },
          "scope": { "enum": ["user", "shared"], "default": "user" }
        }
      }
    },
    "chat": {
      "type": "object",
      "description": "Whether the host page offers its chat for this app. The runtime never renders a chat UI itself (invariant 9) — it only reports panel context and selection for the host's own chat to use; this just turns that reporting on. Anchors describe what the host may let the chat point at or read.",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "anchors": { "type": "array", "items": { "enum": ["panel", "selection", "none"] }, "minItems": 1, "uniqueItems": true, "default": ["panel"] }
      }
    }
  },
  "$defs": {
    "field": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]{0,63}$" },
    "measureId": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" }
  }
}
